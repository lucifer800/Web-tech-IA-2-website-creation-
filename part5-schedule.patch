+}
+
+.schedule__venue {
+  font-size: 14px;
+  color: var(--text-secondary);
+}
+
+.schedule__status {
+  justify-self: end;
+  padding: 5px 10px;
+  font-family: var(--font-mono);
+  font-size: 11px;
+  background: #151922;
+  color: var(--text-secondary);
+}
+
+.schedule__cell--right {
+  text-align: right;
+}
+
+.schedule__empty {
